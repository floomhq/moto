#!/bin/bash
set -euo pipefail

INPUT="${1:-main/main}"
MODE="${2:-}"
REGISTRY="${CS_REGISTRY:-/root/.local/state/codex-guardian/sessions.tsv}"
PENDING_FILE="${CS_PENDING_FILE:-/root/.local/state/codex-guardian/pending-sessions.tsv}"
[[ "$INPUT" != *"/"* ]] && INPUT="$INPUT/main"

tmux_session_id() {
  local session_name="$1"
  tmux list-sessions -F '#{session_name}|#{session_id}' 2>/dev/null \
    | awk -F '|' -v s="$session_name" '$1==s {print $2; exit}' || true
}

attach() {
  local target="$1"
  if [[ "$MODE" == "-CC" ]]; then
    exec tmux -CC attach-session -t "$target"
  else
    exec tmux attach-session -t "$target"
  fi
}

cmdline_for_pid() {
  local pid="$1"
  [[ -n "$pid" && -r "/proc/$pid/cmdline" ]] || return 0
  tr '\0' ' ' < "/proc/$pid/cmdline"
}

descendant_cmdlines_for_pid() {
  local root="$1"
  [[ -n "$root" ]] || return 0
  ps -eo pid=,ppid=,args= | awk -v root="$root" '
    { pid=$1; ppid=$2; $1=""; $2=""; sub(/^  */, "", $0); parent[pid]=ppid; cmd[pid]=$0 }
    END {
      for (pid in cmd) {
        p=pid
        while (p != "" && p != "0") {
          if (p == root) { print cmd[pid]; break }
          p=parent[p]
        }
      }
    }'
}

claude_meta_session_id() {
  local pid="$1"
  local meta="/root/.claude/sessions/${pid}.json"
  [[ -f "$meta" ]] || return 0
  node -e 'const fs=require("fs"); const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.stdout.write(j.sessionId || "")' "$meta" 2>/dev/null || true
}

claude_descendant_session_id() {
  local root="$1"
  [[ -n "$root" ]] || return 0
  ps -eo pid=,ppid= | awk -v root="$root" '
    { parent[$1]=$2 }
    END {
      for (pid in parent) {
        p=pid
        while (p != "" && p != "0") {
          if (p == root) { print pid; break }
          p=parent[p]
        }
      }
    }' | while IFS= read -r child; do
      claude_meta_session_id "$child"
    done | grep -m1 .
}

pane_is_shell_only() {
  local target="$1"
  local pane_cmd
  pane_cmd="$(tmux list-panes -t "$target" -F '#{pane_current_command}' 2>/dev/null | head -1 || true)"
  [[ "$pane_cmd" =~ ^(bash|zsh|sh|fish|tmux)$ ]]
}

claude_transcript_exists() {
  local resume_id="$1"
  [[ -n "${resume_id:-}" && "$resume_id" != "-" ]] || return 1
  find /root/.claude/projects -type f -name "${resume_id}.jsonl" -size +1024c -print -quit 2>/dev/null | grep -q .
}

if [[ ! -f "$REGISTRY" ]]; then
  echo "Error: registry missing: $REGISTRY" >&2
  exit 2
fi

line=$(awk -F '\t' -v s="$INPUT" '$1==s {print; found=1; exit} END{if(!found) exit 1}' "$REGISTRY" || true)
if [[ -z "$line" ]]; then
  tmux_sid="$(tmux_session_id "$INPUT")"
  if [[ -n "$tmux_sid" ]]; then
    attach "$tmux_sid"
  fi

  if [[ "${CS_STRICT:-0}" == "1" ]]; then
    echo "Error: session '$INPUT' is not pinned in $REGISTRY" >&2
    echo "Strict mode refuses to create ad-hoc Claude sessions." >&2
    exit 2
  fi

  mkdir -p "$(dirname "$PENDING_FILE")"
  if ! awk -F '\t' -v s="$INPUT" '$1==s {found=1} END{exit found ? 0 : 1}' "$PENDING_FILE" 2>/dev/null; then
    printf '%s\tclaude\t%s\t/root\n' "$INPUT" "$(date -Iseconds)" >> "$PENDING_FILE"
  fi

  command="/root/bin/cs-launch '$INPUT' env ENABLE_BACKGROUND_TASKS=1 claude --permission-mode dontAsk"
  if [[ "$MODE" == "-CC" ]]; then
    exec tmux -CC new-session -s "$INPUT" -n "$INPUT" -c /root "$command"
  else
    exec tmux new-session -s "$INPUT" -n "$INPUT" -c /root "$command"
  fi
fi

IFS=$'\t' read -r session_name tool resume_id workdir _extra <<< "$line"
if [[ -z "${resume_id:-}" || "$resume_id" == "-" ]]; then
  echo "Error: pinned session '$INPUT' has no resume_id" >&2
  exit 2
fi
[[ -d "${workdir:-}" ]] || workdir="/root"

if [[ "$tool" == "claude" ]] && ! claude_transcript_exists "$resume_id"; then
  echo "Error: pinned Claude session '$INPUT' has no transcript for $resume_id" >&2
  echo "Refusing to create or attach an unproven/empty session mapping." >&2
  exit 2
fi

tmux_sid="$(tmux_session_id "$INPUT")"
if [[ -n "$tmux_sid" ]]; then
  pid="$(tmux list-panes -t "$tmux_sid" -F '#{pane_pid}' 2>/dev/null | head -1 || true)"
  cmd="$(cmdline_for_pid "$pid")"
  child_cmds="$(descendant_cmdlines_for_pid "$pid")"
  case "$tool" in
    claude)
      sid="$(claude_meta_session_id "$pid")"
      [[ -z "$sid" ]] && sid="$(claude_descendant_session_id "$pid" || true)"
      if [[ "$cmd" != *"-r $resume_id"* && "$child_cmds" != *"-r $resume_id"* && "$sid" != "$resume_id" ]]; then
        if pane_is_shell_only "$tmux_sid"; then
          tmux kill-session -t "$tmux_sid" >/dev/null 2>&1 || true
          tmux_sid=""
        else
          echo "Error: live session '$INPUT' does not match pinned Claude ID $resume_id" >&2
          echo "Run /root/bin/session-guardian-status for details. Refusing to attach a mismatched canonical session." >&2
          exit 2
        fi
      fi
      ;;
    codex)
      if [[ "$cmd" != *"resume $resume_id"* && "$child_cmds" != *"resume $resume_id"* ]]; then
        if pane_is_shell_only "$tmux_sid"; then
          tmux kill-session -t "$tmux_sid" >/dev/null 2>&1 || true
          tmux_sid=""
        else
          echo "Error: live session '$INPUT' does not match pinned Codex ID $resume_id" >&2
          echo "Run /root/bin/session-guardian-status for details. Refusing to attach a mismatched canonical session." >&2
          exit 2
        fi
      fi
      ;;
  esac
  [[ -n "$tmux_sid" ]] && attach "$tmux_sid"
fi

case "$tool" in
  claude) command="/root/bin/cs-launch '$INPUT' env ENABLE_BACKGROUND_TASKS=1 claude --permission-mode dontAsk -r $resume_id" ;;
  codex) command="/root/bin/cs-launch '$INPUT' codex resume $resume_id" ;;
  *) echo "Error: pinned session '$INPUT' has unknown tool '$tool'" >&2; exit 2 ;;
esac

if [[ "$MODE" == "-CC" ]]; then
  exec tmux -CC new-session -s "$INPUT" -n "$INPUT" -c "$workdir" "$command"
else
  exec tmux new-session -s "$INPUT" -n "$INPUT" -c "$workdir" "$command"
fi
