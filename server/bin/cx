#!/bin/bash
set -euo pipefail

INPUT="${1:-main/main}"
MODE="${2:-}"
REGISTRY="${CS_REGISTRY:-/root/.local/state/codex-guardian/sessions.tsv}"
PENDING_FILE="${CS_PENDING_FILE:-/root/.local/state/codex-guardian/pending-sessions.tsv}"
[[ "$INPUT" != *"/"* ]] && INPUT="$INPUT/main"

tmux_session_id() {
  local session_name="$1"
  tmux list-sessions -F '#{session_name}|#{session_id}' 2>/dev/null \
    | awk -F '|' -v s="$session_name" '$1==s {print $2; exit}'
}

attach() {
  local target="$1"
  if [[ "$MODE" == "-CC" ]]; then
    exec tmux -CC attach-session -t "$target"
  else
    exec tmux attach-session -t "$target"
  fi
}

tmux_sid="$(tmux_session_id "$INPUT")"
if [[ -n "$tmux_sid" ]]; then
  pid="$(tmux list-panes -t "$tmux_sid" -F '#{pane_pid}' 2>/dev/null | head -1 || true)"
  cmd="$(ps -o comm= -p "$pid" 2>/dev/null || true)"
  cmdline="$(ps -o args= -p "$pid" 2>/dev/null || true)"
  if [[ "$cmd" == "node" ]] && [[ "$cmdline" == *codex* ]]; then
    running="codex"
  elif [[ "$cmd" == "opencode" ]]; then
    running="opencode"
  elif [[ "$cmd" == "claude" ]]; then
    running="claude"
  else
    running="$cmd"
  fi
  if [[ "$running" != "codex" ]]; then
    echo "Error: session \"$INPUT\" is running $running, not codex" >&2
    exit 1
  fi
  attach "$tmux_sid"
fi

resume_id=""
workdir="/root"
if [[ -f "$REGISTRY" ]]; then
  line="$(awk -F '\t' -v s="$INPUT" '$1==s {print; exit}' "$REGISTRY" || true)"
  if [[ -n "$line" ]]; then
    IFS=$'\t' read -r _session tool rid wd _extra <<< "$line"
    if [[ "$tool" == "codex" && -n "${rid:-}" && "$rid" != "-" ]]; then
      resume_id="$rid"
    fi
    [[ -d "${wd:-}" ]] && workdir="$wd"
  fi
fi

if [[ -n "$resume_id" ]]; then
  launch_cmd="/root/bin/cs-launch '$INPUT' codex resume $resume_id"
else
  mkdir -p "$(dirname "$PENDING_FILE")"
  if ! awk -F '\t' -v s="$INPUT" '$1==s {found=1} END{exit found ? 0 : 1}' "$PENDING_FILE" 2>/dev/null; then
    printf '%s\tcodex\t%s\t/root\n' "$INPUT" "$(date -Iseconds)" >> "$PENDING_FILE"
  fi
  launch_cmd="/root/bin/cs-launch '$INPUT' codex --dangerously-bypass-approvals-and-sandbox"
fi

if [[ "$MODE" == "-CC" ]]; then
  exec tmux -CC new-session -s "$INPUT" -n "$INPUT" -c "$workdir" "$launch_cmd"
else
  exec tmux new-session -s "$INPUT" -n "$INPUT" -c "$workdir" "$launch_cmd"
fi
